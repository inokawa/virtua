exports[`should render and hydrate items in horizontal mode 1`] = `"<div style="display:inline-block;overflow-x:auto;contain:strict;width:400px;height:400px"><div style="contain:size style;overflow-anchor:none;flex:none;position:relative;width:100000px;height:100%"><div style="contain:layout style;height:100%;top:0;inset-inline-start:0;display:inline-flex"><div>item-<!-- -->0</div></div><div style="contain:layout style;height:100%;top:0;inset-inline-start:100px;display:inline-flex"><div>item-<!-- -->1</div></div><div style="contain:layout style;height:100%;top:0;inset-inline-start:200px;display:inline-flex"><div>item-<!-- -->2</div></div><div style="contain:layout style;height:100%;top:0;inset-inline-start:300px;display:inline-flex"><div>item-<!-- -->3</div></div><div style="contain:layout style;height:100%;top:0;inset-inline-start:400px;display:inline-flex"><div>item-<!-- -->4</div></div><div style="contain:layout style;height:100%;top:0;inset-inline-start:500px;display:inline-flex"><div>item-<!-- -->5</div></div><div style="contain:layout style;height:100%;top:0;inset-inline-start:600px;display:inline-flex"><div>item-<!-- -->6</div></div><div style="contain:layout style;height:100%;top:0;inset-inline-start:700px;display:inline-flex"><div>item-<!-- -->7</div></div><div style="contain:layout style;height:100%;top:0;inset-inline-start:800px;display:inline-flex"><div>item-<!-- -->8</div></div><div style="contain:layout style;height:100%;top:0;inset-inline-start:900px;display:inline-flex"><div>item-<!-- -->9</div></div></div></div>"`;

exports[`should render and hydrate items in vertical mode 1`] = `"<div style="display:block;overflow-y:auto;contain:strict;width:400px;height:400px"><div style="contain:size style;overflow-anchor:none;flex:none;position:relative;width:100%;height:100000px"><div style="contain:layout style;width:100%;left:0;top:0"><div>item-<!-- -->0</div></div><div style="contain:layout style;width:100%;left:0;top:100px"><div>item-<!-- -->1</div></div><div style="contain:layout style;width:100%;left:0;top:200px"><div>item-<!-- -->2</div></div><div style="contain:layout style;width:100%;left:0;top:300px"><div>item-<!-- -->3</div></div><div style="contain:layout style;width:100%;left:0;top:400px"><div>item-<!-- -->4</div></div><div style="contain:layout style;width:100%;left:0;top:500px"><div>item-<!-- -->5</div></div><div style="contain:layout style;width:100%;left:0;top:600px"><div>item-<!-- -->6</div></div><div style="contain:layout style;width:100%;left:0;top:700px"><div>item-<!-- -->7</div></div><div style="contain:layout style;width:100%;left:0;top:800px"><div>item-<!-- -->8</div></div><div style="contain:layout style;width:100%;left:0;top:900px"><div>item-<!-- -->9</div></div></div></div>"`;

exports[`should render no cells and hydrate a grid 1`] = `"<div role="table" aria-rowcount="1000" aria-colcount="1000" style="overflow:auto;contain:strict;width:400px;height:400px"><div style="contain:size style;overflow-anchor:none;flex:none;display:grid;grid-template-rows:[l0] minmax(40000px,auto) [l1000];grid-template-columns:[l0] minmax(100000px,auto) [l1000];gap:0;margin-top:0;margin-inline-start:0;height:40000px"></div></div>"`;

