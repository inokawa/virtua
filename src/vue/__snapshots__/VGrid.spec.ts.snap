exports[`should render 4x4 cells 1`] = `
"<div role="table" aria-rowcount="4" aria-colcount="4" style="overflow: auto; contain: strict; width: 100%; height: 100%;" aria-label="grid">
  <div style="contain: size style; overflow-anchor: none; flex: 0 0 auto; display: grid; grid-template-rows: [l0] 40px [l1] 40px [l2] 40px [l3] 40px [l4]; grid-template-columns: [l0] 100px [l1] 100px [l2] 100px [l3] 100px [l4]; gap: 0px; height: 500px; margin-top: 0px; margin-inline-start: 0px;">
    <div role="rowgroup" style="display: grid; grid-template-rows: subgrid; grid-template-columns: subgrid; grid-area: l0 / 1 / l1 / -1; position: sticky; top: 0px; z-index: 4;">
      <div role="row" aria-rowindex="1" style="display: grid; grid-template-rows: subgrid; grid-template-columns: subgrid; grid-area: l0 / 1 / l1 / -1;">
        <div role="columnheader" aria-colindex="1" style="contain: layout style; display: grid; grid-area: 1 / l0; inset-inline-start: 0px; position: sticky; z-index: 2;">
          <div>aw 0 / 0</div>
        </div>
        <div role="columnheader" aria-colindex="2" aria-sort="ascending" style="contain: layout style; display: grid; grid-area: 1 / l1;">
          <div>ax 0 / 1</div>
        </div>
        <div role="columnheader" aria-colindex="3" style="contain: layout style; display: grid; grid-area: 1 / l2;">
          <div>ay 0 / 2</div>
        </div>
        <div role="columnheader" aria-colindex="4" style="contain: layout style; display: grid; grid-area: 1 / l3;">
          <div>az 0 / 3</div>
        </div>
      </div>
    </div>
    <div role="row" aria-rowindex="2" style="display: grid; grid-template-rows: subgrid; grid-template-columns: subgrid; grid-area: l1 / 1 / l2 / -1;">
      <div role="rowheader" aria-colindex="1" style="contain: layout style; display: grid; grid-area: 1 / l0; inset-inline-start: 0px; position: sticky; z-index: 2;">
        <div>bw 1 / 0</div>
      </div>
      <div role="cell" aria-colindex="2" aria-rowspan="1" aria-colspan="2" style="contain: layout style; display: grid; grid-area: 1 / l1 / l2 / l3; width: 0px; min-width: 100%;">
        <div>bx 1 / 1</div>
      </div>
      <div role="cell" aria-colindex="4" style="contain: layout style; display: grid; grid-area: 1 / l3;">
        <div>bz 1 / 3</div>
      </div>
    </div>
    <div role="row" aria-rowindex="3" style="display: grid; grid-template-rows: subgrid; grid-template-columns: subgrid; grid-area: l2 / 1 / l4 / -1;">
      <div role="rowheader" aria-colindex="1" aria-rowspan="2" aria-colspan="1" style="contain: layout style; display: grid; grid-area: 1 / l0 / l4 / l1; height: 0px; min-height: 100%; z-index: 2; inset-inline-start: 0px; position: sticky;">
        <div>cw 2 / 0</div>
      </div>
      <div role="cell" aria-colindex="2" style="contain: layout style; display: grid; grid-area: 1 / l1;">
        <div>cx 2 / 1</div>
      </div>
      <div role="cell" aria-colindex="3" style="contain: layout style; display: grid; grid-area: 1 / l2;">
        <div>cy 2 / 2</div>
      </div>
      <div role="cell" aria-colindex="4" style="contain: layout style; display: grid; grid-area: 1 / l3;">
        <div>cz 2 / 3</div>
      </div>
    </div>
    <div role="row" aria-rowindex="4" style="display: grid; grid-template-rows: subgrid; grid-template-columns: subgrid; grid-area: l3 / 1 / l4 / -1;">
      <div role="cell" aria-colindex="2" style="contain: layout style; display: grid; grid-area: 1 / l1;">
        <div>dx 3 / 1</div>
      </div>
      <div role="cell" aria-colindex="3" style="contain: layout style; display: grid; grid-area: 1 / l2;">
