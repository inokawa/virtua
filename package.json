{
  "name": "virtua",
  "version": "0.54.2",
  "description": "A zero-config, fast and small virtual list, grid and masonry component for React, Vue, Solid, Svelte and Angular.",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    },
    "./vue": {
      "types": "./lib/vue/index.d.ts",
      "require": "./lib/vue/index.cjs",
      "default": "./lib/vue/index.js"
    },
    "./solid": {
      "types": "./lib/solid/index.d.ts",
      "solid": "./lib/solid/index.jsx",
      "require": "./lib/solid/index.cjs",
      "default": "./lib/solid/index.js"
    },
    "./svelte": {
      "types": "./lib/svelte/index.d.ts",
      "svelte": "./lib/svelte/index.js",
      "default": "./lib/svelte/index.js"
    },
    "./angular": {
      "types": "./lib/angular/index.d.ts",
      "default": "./lib/angular/index.js"
    },
    "./unstable_core": {
      "types": "./lib/core/index.d.ts",
      "require": "./lib/core/index.cjs",
      "default": "./lib/core/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf lib && vite build -c vite.build.config.ts -m react && vite build -c vite.build.config.ts -m vue && vite build -c vite.build.config.ts -m solid && vite build -c vite.build.config.ts -m solid-ssr && vite build -c vite.build.config.ts -m core && vite build -c vite.build.config.ts -m svelte && vite build -c vite.build.config.ts -m angular && ngc -p tsconfig.angular.build.json && node scripts/copy-angular-dts.js",
    "tsc": "tsc -p . --noEmit",
    "test": "vitest run --project=unit --project=react --project=vue --project=solid --project=svelte --project=angular",
    "test:browser": "vitest run --project=\"browser-*\"",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}' --cache",
    "format": "prettier '**/*.{js,ts,jsx,tsx,vue,svelte}' --write --cache",
    "format:ci": "prettier '**/*.{js,ts,jsx,tsx,vue,svelte}' -l",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json",
    "check:angular": "ngc -p tsconfig.angular.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:rtl": "STORYBOOK_RTL=1 npm run storybook",
    "storybook:vue": "STORYBOOK_VUE=1 npm run storybook",
    "storybook:solid": "STORYBOOK_SOLID=1 npm run storybook",
    "storybook:svelte": "STORYBOOK_SVELTE=1 npm run storybook",
    "storybook:angular": "STORYBOOK_ANGULAR=1 npm run storybook",
    "storybook:build": "storybook build",
    "storybook:deploy": "STORYBOOK_DEPLOY=1 npm run storybook:build && STORYBOOK_VUE=1 npm run storybook:build -- -o storybook-static/vue && STORYBOOK_SOLID=1 npm run storybook:build -- -o storybook-static/solid && STORYBOOK_SVELTE=1 npm run storybook:build -- -o storybook-static/svelte && STORYBOOK_ANGULAR=1 npm run storybook:build -- -o storybook-static/angular",
    "typedoc": "typedoc",
    "size": "size-limit",
    "prepublishOnly": "npm run typedoc && npm run build"
  },
  "devDependencies": {
    "@analogjs/storybook-angular": "^2.9.6",
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@analogjs/vitest-angular": "^2.9.6",
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/animations": "^22.2.5",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "^4.2.4",
    "@base-ui/react": "^1.9.0",
    "@chenglou/pretext": "^1.0.0",
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@faker-js/faker": "^10.6.0",
    "@mui/material": "^9.5.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@solidjs/testing-library": "^0.8.10",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/angular": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@storybook/svelte-vite": "^10.6.6",
    "@storybook/vue3-vite": "^10.6.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/vue": "^8.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-solid": "^0.18.1",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^31.0.0",
    "motion": "^14.10.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-virtualized": "^10.0.0",
    "react-virtualized-auto-sizer": "^2.0.4",
    "react-virtuoso": "^4.18.20",
    "react-window": "^2.5.3",
    "rimraf": "^6.1.4",
    "size-limit": "^14.3.0",
    "solid-js": "^1.9.18",
    "storybook": "^10.6.6",
    "storybook-solidjs-vite": "^10.7.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "terser": "^5.51.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "virtua": "^0.54.2",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2"
  },
  "overrides": {
    "@analogjs/vitest-angular": {
      "vitest": "$vitest"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0",
    "@angular/core": ">=20.0.0",
    "react": ">=16.14.0",
    "react-dom": ">=16.14.0",
    "solid-js": ">=1.0",
    "svelte": ">=5.0",
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inokawa/virtua.git"
  },
  "keywords": [
    "react",
    "react-component",
    "vue",
    "solid",
    "svelte",
    "angular",
    "ui",
    "headless",
    "list",
    "grid",
    "table",
    "flex",
    "masonry",
    "scroll",
    "scroller",
    "scrolling",
    "virtual",
    "virtualized",
    "virtualization",
    "infinite",
    "windowing"
  ],
  "author": "inokawa <stratoooo-taster@yahoo.co.jp> (https://github.com/inokawa/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/inokawa/virtua/issues"
  },
  "homepage": "https://github.com/inokawa/virtua#readme"
}
